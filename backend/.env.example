# ==============================================================================
# AWS GUARDIAN - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production on Render: Set DEBUG=False
DEBUG=False

# Replace with a strong random secret key (Render Blueprints generate this automatically)
DJANGO_SECRET_KEY=generate-a-strong-random-key-for-production-use

# Secret used to sign JWT tokens
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-key

# Comma-separated list of allowed hostnames (e.g. your-app.onrender.com,localhost)
# On Render, RENDER_EXTERNAL_HOSTNAME is automatically added by settings.py
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Render provides DATABASE_URL automatically when a PostgreSQL database is attached.
# Example: postgresql://guardian_user:password@dpg-xxxx.render.com/aws_guardian
DATABASE_URL=

# Fallback engine options if DATABASE_URL is not set: 'mysql', 'sqlite', or 'postgresql'
DB_ENGINE=sqlite

# Local PostgreSQL credentials (used if DB_ENGINE=postgresql and DATABASE_URL is not set)
POSTGRES_DB=aws_guardian
POSTGRES_USER=guardian_user
POSTGRES_PASSWORD=guardian_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local MySQL credentials (used if DB_ENGINE=mysql and DATABASE_URL is not set)
MYSQL_DB=aws_guardian
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 3. CORS & CSRF SETTINGS
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. FIREBASE PUSH NOTIFICATIONS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Paste the raw JSON string content of your firebase-service-account.json here
# This allows Firebase push notifications on Render without storing keys in git!
FIREBASE_CREDENTIALS_JSON=

# Or path to service account json file (for local development)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=aws-guardian

# Set to True if testing without active Firebase keys (prevents errors)
MOCK_FCM=True

# ------------------------------------------------------------------------------
# 5. AUTOMATED SCHEDULE & TIMEZONE
# ------------------------------------------------------------------------------
MORNING_SCAN_TIME=09:00
EVENING_SCAN_TIME=18:00
SCAN_TIMEZONE=Asia/Kolkata
